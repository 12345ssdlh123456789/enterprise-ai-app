# ============ 应用基础配置 ============
NODE_ENV=development
APP_NAME=Enterprise AI App
APP_VERSION=0.0.1
APP_PORT=3000
APP_HOST=0.0.0.0
API_PREFIX=/api/v1

# ============ 数据库配置 ============
# PostgreSQL with pgvector
POSTGRES_USER=enterprise_ai
POSTGRES_PASSWORD=enterprise_ai_dev
POSTGRES_DB=enterprise_ai
DATABASE_URL=postgresql://enterprise_ai:enterprise_ai_dev@localhost:5432/enterprise_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
# 启动时用 Alembic 迁移建表（生产保持 true）；设为 false 才退回 create_all（仅临时环境）
DB_AUTO_MIGRATE=true
DATABASE_ECHO=false

# ============ Redis 配置 ============
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_CONNECT_TIMEOUT=10000

# ============ 认证配置 ============
# 生产环境必须使用至少 32 字符的强密钥，建议 64 字符+
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars-please-generate-a-strong-one
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12

# OAuth2 / SSO (可选)
OAUTH2_ENABLED=false
OAUTH2_PROVIDER=google
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_CALLBACK_URL=http://localhost:3000/auth/callback
OAUTH2_SCOPE=openid profile email

# ============ LLM 提供商配置 ============
# OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=

# 本地模型
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=

# 默认模型
DEFAULT_CHAT_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_RERANK_MODEL=

# Embedding（RAG 服务用）
# 本地无 OpenAI Key 时可指向 Ollama：EMBEDDING_API_BASE=http://127.0.0.1:11434/v1
# EMBEDDING_API_KEY=ollama / EMBEDDING_MODEL=embeddinggemma:300m / EMBEDDING_DIM=768
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ============ 向量数据库配置 ============
VECTOR_DB_PROVIDER=pgvector
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_INDEX_NAME=enterprise_ai

# ============ RAG 配置 ============
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_TOP_K=5
DEFAULT_SCORE_THRESHOLD=0.7
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANK=true

# ============ 文件上传配置 ============
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,md,html,csv,json,pptx,xlsx
UPLOAD_DIR=./uploads
TEMP_DIR=./tmp

# ============ 限流配置 ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_TOKENS=100000
RATE_LIMIT_ENABLED=true

# ============ 任务队列配置 ============
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# ============ 监控配置 ============
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=info
LOG_FORMAT=pretty

# ============ 存储配置 ============
STORAGE_PROVIDER=local
# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=enterprise-ai
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1

# ============ 邮件配置 ============
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@enterprise-ai.local

# ============ Webhook 配置 ============
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_MAX_RETRIES=3

# ============ 成本控制 ============
DEFAULT_MONTHLY_TOKEN_BUDGET=1000000
COST_ALERT_THRESHOLD=0.8
ENABLE_COST_TRACKING=true

# ============ 安全配置 ============
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_SECRET=
HELMET_ENABLED=true

# ============ 功能开关 ============
ENABLE_RAG=true
ENABLE_WORKFLOWS=true
ENABLE_MULTIMODAL=false
ENABLE_ANALYTICS=true
ENABLE_AUDIT_LOG=true

# ============ MinIO 配置 ============
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# 服务间签名密钥：网关转发 / 微服务互调时用 HMAC-SHA256 签名（留空 = 本地开发模式，不校验）
SERVICE_API_KEY=dev-internal-key

# document-service 解析完成后自动把正文送 rag-service 入库（上传即入库）
RAG_SERVICE_URL=http://127.0.0.1:8001
AUTO_INGEST_TO_RAG=true

# 预签名 /upload/complete 成功后自动解析（解析成功才会继续自动入库）
AUTO_PROCESS_ON_UPLOAD=true

# 网关 → document-service 转发试点（默认关；开启前两侧必须配同一个 SERVICE_API_KEY）
GATEWAY_PROXY_DOCUMENTS=false

# 网关 → workflow-service 转发试点（默认关；需要与微服务同一个 SERVICE_API_KEY）
GATEWAY_PROXY_WORKFLOWS=false
WORKFLOW_SERVICE_URL=http://127.0.0.1:8005

# 网关 → notification-service 转发（默认关；两侧契约已对齐，同样需要同一个 SERVICE_API_KEY）
GATEWAY_PROXY_NOTIFICATIONS=false
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8006
