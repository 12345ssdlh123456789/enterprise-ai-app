# Enterprise AI App - 项目根目录 .gitignore

# 依赖目录
node_modules/
.pnp
.pnp.js

# 构建产物
dist/
build/
.next/
out/
*.tsbuildinfo

# 环境变量 (不提交真实密钥)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE/编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS 生成文件
.DS_Store
Thumbs.db

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 测试覆盖率
coverage/
.nyc_output/

# 临时文件
tmp/
temp/
*.tmp
*.temp

# 上传文件
uploads/
data/

# Docker
.docker/

# Turbo
.turbo/

# 类型检查缓存
*.tsbuildinfo

# 数据库迁移 (生成的文件不提交，但迁移脚本提交)
**/migrations/*.pyc
**/migrations/__pycache__/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
.envrc

# 证书/密钥
*.pem
*.key
*.crt
*.p12

# 本地开发数据库
*.db
*.sqlite
*.sqlite3

# OS 特定
Thumbs.db
ehthumbs.db
Desktop.ini
# Playwright
apps/web/test-results/
apps/web/playwright-report/
apps/web/playwright/.cache/
apps/admin/test-results/
apps/admin/playwright-report/
apps/admin/playwright/.cache/
