# Document Service Configuration
# Copy to .env and fill in values

# App
APP_NAME=document-service
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8004

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai

# Redis
REDIS_URL=redis://localhost:6379/4

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documents
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# File Processing
MAX_FILE_SIZE=104857600
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,image/png,image/jpeg,image/tiff
UPLOAD_DIR=/app/uploads

# OCR
TESSERACT_CMD=tesseract
TESSERACT_LANG=chi_sim+eng

# API Gateway
API_GATEWAY_URL=http://localhost:8000
SERVICE_API_KEY=your_service_api_key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_PORT=9094