# LLM Service Configuration
# Copy to .env and fill in values

# App
APP_NAME=llm-service
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8003

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai

# Redis
REDIS_URL=redis://localhost:6379/3

# Provider API Keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_API_BASE=https://api.anthropic.com
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15-preview
OLLAMA_BASE_URL=http://localhost:11434

# Default Models
DEFAULT_CHAT_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Load Balancing
LB_STRATEGY=round_robin
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
TIMEOUT_SECONDS=60.0

# Cost Tracking (micro-USD per 1K tokens)
COST_TRACKING_ENABLED=true
COST_PER_1K_TOKENS={"gpt-4o": {"input": 5000000, "output": 15000000}, "gpt-4o-mini": {"input": 150000, "output": 600000}, "claude-3-5-sonnet": {"input": 3000000, "output": 15000000}, "claude-3-haiku": {"input": 250000, "output": 1250000}}

# Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60
CB_HALF_OPEN_REQUESTS=3

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_PORT=9093