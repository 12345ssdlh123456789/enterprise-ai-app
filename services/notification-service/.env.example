# Notification Service Environment Configuration

NOTIFICATION_SERVICE_PORT=8006
NOTIFICATION_SERVICE_HOST=0.0.0.0

DATABASE_URL=postgresql+asyncpg://notification_user:notification_pass@postgres:5432/notification_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/1

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

WEBHOOK_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3000,http://localhost:8000

OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
